# Copia este archivo como ".env" y rellena los valores.
# El archivo .env NO se sube a git (contiene secretos).

# --- Correo (formulario de contacto) ---
# Usuario de Gmail y su "contraseña de aplicación" (no la contraseña normal).
# Se crea en https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Quién recibe los mensajes del formulario de contacto (si se omite, la misma cuenta)
CONTACT_RECIPIENT=

# --- Opcionales (para producción) ---
# DJANGO_SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=midominio.com,www.midominio.com

# --- Asistente IA del chat (opcional, APAGADO por defecto) ---
# Sin esto el chat funciona igual con preguntas frecuentes, sin coste.
# La API de Claude se factura aparte de cualquier suscripción: https://console.anthropic.com
# CHAT_IA_ENABLED=True
# ANTHROPIC_API_KEY=
# CHAT_IA_MODEL=claude-haiku-5-5
# CHAT_IA_MAX_TOKENS=400
